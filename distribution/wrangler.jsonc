{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phasesai-setup-downloads",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-21",
  "workers_dev": false,
  "routes": [{ "pattern": "downloads.phasesai.cc", "custom_domain": true }],
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "phasesai-setup-releases" }],
  "observability": { "enabled": true, "head_sampling_rate": 0.01, "logs": { "enabled": true, "invocation_logs": false } }
}
